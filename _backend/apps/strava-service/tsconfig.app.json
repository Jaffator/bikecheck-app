{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "declaration": false,
    // Kept out of outDir so a cleaned dist does not take the incremental cache with it.
    "tsBuildInfoFile": "../../node_modules/.cache/tsc/strava-service.tsbuildinfo",
    "outDir": "../../dist/apps/strava-service"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "**/*spec.ts"]
}
