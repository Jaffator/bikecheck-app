<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <!-- Dark window background shows through in the gesture nav bar strip,
             which the WebView doesn't extend into, so it matches the footer
             instead of showing white. (Removed the legacy
             android:background=@drawable/splash: that white PNG was a DecorView
             background drawn OVER windowBackground, so it kept the strip white.
             Android 12+ uses the SplashScreen API, not that drawable.) -->
        <item name="android:windowBackground">@color/app_background</item>
        <!-- statusBarColor/navigationBarColor are deprecated no-ops on
             targetSdk 35+ (edge-to-edge), so bar *background* is handled by the
             web layout drawing behind the bars (safe-area insets in AppLayout).
             These only control the *icon* brightness, which still works:
             false = light icons, for our dark header/footer. -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>