# Committed env for `npm run android:release`; a mode file beats .env/.env.local, so any checkout builds the same bundle.
# Public values only: every VITE_ variable ships in the JavaScript.
# Absolute: a relative /api would be served by Capacitor's own local server.
VITE_API_BASE_URL=https://app.bikecheck.cloud/api
# Umami "App" website (repo variables UMAMI_WEBSITE_ID_APP, STATS_HOST, TRACKER_SCRIPT_NAME).
VITE_UMAMI_WEBSITE_ID=8deb4559-d0ea-43d3-a83e-e7a6d0275d2e
VITE_UMAMI_SCRIPT_URL=https://stats.bikecheck.cloud/bc.js
