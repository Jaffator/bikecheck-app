# Copy to .env.pi on the Raspberry Pi (git-ignored) and fill in. Read by docker-compose.pi.yml.

# The release whose scraper image runs; bump it, then `pull` and `up -d` (docs/deploy.md).
TAG=v1.6.0
# The same value as SCRAPER_API_SECRET in the server's .env.production.
SCRAPER_API_SECRET=change-me

# ---------- Grafana Cloud (alloy service: Pi metrics, container logs, prod probe) ----------
# The same values as GRAFANA_CLOUD_* in the server's .env.production.
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-eu-west-X.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=
GRAFANA_CLOUD_TOKEN=
# What the Pi probes every minute: the site (Caddy + TLS) and the monolith (+ Postgres).
PROD_SITE_URL=https://app.bikecheck.cloud/
PROD_API_HEALTH_URL=https://app.bikecheck.cloud/api/health
