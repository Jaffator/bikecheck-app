// Ships the home Pi's metrics and the scraper's logs to Grafana Cloud.
// Credentials come from .env.pi (GRAFANA_CLOUD_*); see .env.pi.example.

// ---------- Metrics: the Pi (CPU, RAM, SD card, network, temperature) ----------
// Host PID and network namespaces, so /proc and /sys are the Pi's; hwmon/thermal_zone give the SoC temperature.
prometheus.exporter.unix "host" {
  rootfs_path = "/rootfs"
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  job_name        = "integrations/unix"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.instance.receiver]
}

// ---------- Metrics: each container (CPU, RAM) ----------
prometheus.exporter.cadvisor "containers" {
  docker_host      = "unix:///var/run/docker.sock"
  docker_only      = true
  storage_duration = "5m"
}

prometheus.scrape "containers" {
  targets         = prometheus.exporter.cadvisor.containers.targets
  job_name        = "integrations/docker"
  scrape_interval = "60s"
  forward_to      = [prometheus.relabel.instance.receiver]
}

// Its own instance name, so the Pi never mixes into the server's dashboards.
prometheus.relabel "instance" {
  forward_to = [prometheus.remote_write.cloud.receiver]

  rule {
    target_label = "instance"
    replacement  = "bikecheck-pi"
  }
}

prometheus.remote_write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_PROM_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_PROM_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

// ---------- Logs: stdout of every container ----------
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "logs" {
  targets = []

  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "service_name"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  labels        = { instance = "bikecheck-pi" }
  relabel_rules = discovery.relabel.logs.rules
  forward_to    = [loki.write.cloud.receiver]
}

loki.write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_CLOUD_LOKI_URL")

    basic_auth {
      username = sys.env("GRAFANA_CLOUD_LOKI_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}
