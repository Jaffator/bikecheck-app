# Copy to .env.production (git-ignored) and fill in. Read twice: by compose for ${...} substitution
# (`docker compose --env-file .env.production -f docker-compose.prod.yml ...`) and as env_file of both apps.
# Set by docker-compose.prod.yml, do not set here: NODE_ENV, PORT, DATABASE_URL, REDIS_HOST,
# STRAVA_SERVICE_URL, SPA_INDEX_HTML.

# ---------- Host ----------
# Bare host for Caddy's site block and the same host as an https origin; they must agree.
PUBLIC_HOST=bikecheck.cloud
PUBLIC_APP_URL=https://bikecheck.cloud
# Where the monolith sends the browser after Google login.
FRONTEND_URL=https://bikecheck.cloud
# Comma-separated. Add the Capacitor WebView origin (https://localhost) once the APK talks to this host.
CORS_ORIGINS=https://bikecheck.cloud

# ---------- Postgres (both databases share the role) ----------
# Letters and digits only: the password lands unescaped inside DATABASE_URL.
POSTGRES_USER=bikecheck
POSTGRES_PASSWORD=change-me

# ---------- Bull Board behind Caddy basic auth (/api/queues) ----------
# Hash: `docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'`.
# Keep the single quotes: the bcrypt hash contains `$`, which compose would otherwise expand.
OPS_USER=admin
OPS_PASSWORD_HASH='$2a$14$replace-with-caddy-hash-password-output'

# ---------- Monolith ----------
JWT_SECRET=change-me
JWT_EXPIRATION_DEV=900
JWT_EXPIRATION_PROD=86400
REFRESH_TOKEN_EXPIRATION_DAYS=365
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_CHAT_DAILY_TOKEN_BUDGET=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_BUCKET_NAME=bikecheck
CLOUDFLARE_PUBLIC_URL=https://<r2-public-host>
FIREBASE_SERVICE_ACCOUNT_BASE64=
RESEND_API_KEY=
MAIL_FROM=BikeCheck <noreply@bikecheck.cloud>

# ---------- Shared by both apps ----------
INTERNAL_API_SECRET=change-me
# pino-loki push target; without a Loki the transport only logs a connection error.
LOKI_HOST=http://localhost:3100

# ---------- strava-service ----------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Custom scheme ending in "://": the OAuth redirect hands the phone back to the installed app.
APP_DEEP_LINK_URL=bikecheck://
