# Copy to .env.production (git-ignored) and fill in. Read twice: by compose for ${...} substitution
# (`docker compose --env-file .env.production -f docker-compose.prod.yml ...`) and as env_file of both apps.
# Set by docker-compose.prod.yml, do not set here: NODE_ENV, PORT, DATABASE_URL, REDIS_HOST,
# STRAVA_SERVICE_URL, SPA_INDEX_HTML.

# ---------- Hosts (ADR 0041) ----------
# The Marketing Website's bare host; www redirects to it.
WEBSITE_HOST=bikecheck.cloud
# The App's bare host for Caddy's site block and the same host as an https origin; they must agree.
PUBLIC_HOST=app.bikecheck.cloud
PUBLIC_APP_URL=https://app.bikecheck.cloud
# Where the monolith sends the browser after Google login, and strava-service after a web Strava connect.
FRONTEND_URL=https://app.bikecheck.cloud
# Comma-separated. Add the Capacitor WebView origin (https://localhost) once the APK talks to this host.
CORS_ORIGINS=https://app.bikecheck.cloud

# ---------- Umami (cookieless stats for the Marketing Website and the App) ----------
# Needs its own DNS A record. First login is admin / umami: change it at once (docs/deploy.md).
STATS_HOST=stats.bikecheck.cloud
# `openssl rand -hex 32`.
UMAMI_APP_SECRET=change-me
# Neutral names ad blockers don't know. Umami reads both; the static builds only the script name.
TRACKER_SCRIPT_NAME=bc.js
COLLECT_API_ENDPOINT=/api/bc
# Umami → Settings → Websites: "Web" and "App". Empty ID: that build ships without the tracker.
# Both are baked in at build time, so a new ID needs a rebuild of caddy.
UMAMI_WEBSITE_ID_WEB=
UMAMI_WEBSITE_ID_APP=

# ---------- Postgres (all databases share the role) ----------
# Letters and digits only: the password lands unescaped inside DATABASE_URL.
POSTGRES_USER=bikecheck
POSTGRES_PASSWORD=change-me

# ---------- Bull Board behind Caddy basic auth (/api/queues) ----------
# Hash: `docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'`.
# Keep the single quotes: the bcrypt hash contains `$`, which compose would otherwise expand.
OPS_USER=admin
OPS_PASSWORD_HASH='$2a$14$replace-with-caddy-hash-password-output'

# ---------- Monolith ----------
JWT_SECRET=change-me
JWT_EXPIRATION_DEV=900
JWT_EXPIRATION_PROD=86400
REFRESH_TOKEN_EXPIRATION_DAYS=365
# Required: the monolith refuses to boot without the client ID and the callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must also be listed as a redirect URI on the Google Web client.
GOOGLE_CALLBACK_URL=https://app.bikecheck.cloud/api/auth/google/callback
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_CHAT_DAILY_TOKEN_BUDGET=
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_BUCKET_NAME=bikecheck
CLOUDFLARE_PUBLIC_URL=https://<r2-public-host>
FIREBASE_SERVICE_ACCOUNT_BASE64=
RESEND_API_KEY=
MAIL_FROM=BikeCheck <info@email.bikecheck.cloud>

# ---------- Shared by both apps ----------
INTERNAL_API_SECRET=change-me
# Optional pino-loki push target. Logs always go to stdout (`docker logs`); set this only for a real Loki.
# LOKI_HOST=

# ---------- Grafana Cloud (alloy service: server + container metrics, container logs) ----------
# grafana.com → your stack → Prometheus / Loki "Details": the push URLs and their numeric user IDs.
GRAFANA_CLOUD_PROM_URL=https://prometheus-prod-XX-prod-eu-west-X.grafana.net/api/prom/push
GRAFANA_CLOUD_PROM_USER=
GRAFANA_CLOUD_LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_USER=
# Access policy token with metrics:write and logs:write.
GRAFANA_CLOUD_TOKEN=

# ---------- strava-service ----------
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Custom scheme ending in "://": the OAuth redirect hands the phone back to the installed app.
APP_DEEP_LINK_URL=bikecheck://
