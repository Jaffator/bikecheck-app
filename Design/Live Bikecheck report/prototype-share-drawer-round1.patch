+// PROTOTYPE #121 — variant B "Odkaz napřed": the sheet is a share sheet. The link is the
+// hero, the audience is a radio list with a sentence each, sections are chips, bikes a grid.
+import { useState, type ReactElement } from "react";
+import {
+  ActionIcon,
+  Box,
+  Button,
+  Chip,
+  Drawer,
+  Group,
+  Image,
+  Radio,
+  SimpleGrid,
+  Stack,
+  Text,
+  TextInput,
+} from "@mantine/core";
+import { Check, Globe, Lock, Pencil, Users } from "lucide-react";
+import { useOverlayBack } from "@/hooks/useOverlayBack";
+import { chipStyles, inputStyles } from "@/features/add_bike_page/formStyles";
+import { bikeTitle } from "@/features/bikes/bikeTitle";
+import { handleError, profileHost } from "./handle";
+import {
+  usePrototypeStore,
+  VISIBILITY_HINT,
+  VISIBILITY_LABEL,
+  type SectionKey,
+  type Visibility,
+} from "./prototype.store";
+import { LinkActions } from "./LinkActions";
+import { DRAWER_PROPS, EYEBROW, INSET, STATE_COLOR, useProfileBikes } from "./shared";
+
+const STATE_ICON: Record<Visibility, ReactElement> = {
+  OFF: <Lock size={14} />,
+  FOLLOWERS: <Users size={14} />,
+  PUBLIC: <Globe size={14} />,
+};
+
+function LinkHero(): ReactElement {
+  const visibility = usePrototypeStore((state) => state.visibility);
+  const setVisibility = usePrototypeStore((state) => state.setVisibility);
+  const handle = usePrototypeStore((state) => state.handle);
+  const setHandle = usePrototypeStore((state) => state.setHandle);
+  const [editing, setEditing] = useState(false);
+  const error = handleError(handle);
+  const isPublic = visibility === "PUBLIC";
+  const off = visibility === "OFF";
+
+  return (
+    <Box
+      p="md"
+      style={{
+        borderRadius: "1rem",
+        // A live link glows; a switched-off one is pressed into the sheet (ReportCard's revoked look).
