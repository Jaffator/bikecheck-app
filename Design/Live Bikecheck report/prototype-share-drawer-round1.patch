+            <Group gap="sm" wrap="nowrap">
+              <Share2 size={18} color="var(--mantine-color-primary-6)" />
+              <Text fw={600} fz={15} c="text.6">
+                Sdílej svou garáž
+              </Text>
+            </Group>
+            <ChevronRight size={18} color="var(--color-text-dim)" />
+          </Group>
+        </Paper>
+      </UnstyledButton>
+    );
+  }
+
+  const figures = statsFor(visibility, stats);
+
+  return (
+    <UnstyledButton onClick={open} className="active:scale-[0.985]" style={{ display: "block" }}>
+      <Paper radius="lg" p="md" style={PANEL}>
+        <Stack gap="sm">
+          <Group justify="space-between" wrap="nowrap">
+            <Text {...EYEBROW}>Garáž · {VISIBILITY_LABEL[visibility]}</Text>
+            <StateIcon size={16} />
+          </Group>
+          <Group gap={0} grow>
+            {figures.map((figure) => (
+              <Stack key={figure.label} gap={0}>
+                <Text
+                  className="font-mono"
+                  fz={32}
+                  fw={700}
+                  c={figure.label === "Žádosti" && figure.value > 0 ? "primary.5" : "text.6"}
+                  style={{ lineHeight: 1.1 }}
+                >
+                  {figure.value}
+                </Text>
+                <Text {...EYEBROW}>{figure.label}</Text>
+              </Stack>
+            ))}
+          </Group>
+        </Stack>
+      </Paper>
+    </UnstyledButton>
+  );
+}
+
+function CardC(): ReactElement | null {
+  const visibility = usePrototypeStore((state) => state.visibility);
+  const stats = usePrototypeStore((state) => state.stats);
+  const open = usePrototypeStore((state) => state.openDrawer);
+
+  // Nothing to report while nobody sees anything; the way in is the garage and Settings.
+  if (visibility === "OFF") return null;
+
+  const pending = visibility === "FOLLOWERS" ? stats.pending : 0;
+  const figures = statsFor(visibility, stats).filter((figure) => figure.label !== "Žádosti");
+
+  return (
+    <Paper radius="lg" p="md" style={PANEL}>
+      <Stack gap="sm">
+        <Group justify="space-between" wrap="nowrap">
+          <Group gap={8} wrap="nowrap">
+            <StateIcon size={16} />
+            <Text fw={600} fz={16} c="text.6">
+              {visibility === "PUBLIC" ? "Garáž je veřejná" : "Garáž sdílíš se sledujícími"}
+            </Text>
+          </Group>
+          <UnstyledButton onClick={open} aria-label="Nastavení sdílení">
+            <ChevronRight size={18} color="var(--color-text-dim)" />
+          </UnstyledButton>
+        </Group>
+
+        {pending > 0 ? (
+          <Group
+            justify="space-between"
+            wrap="nowrap"
+            p="sm"
+            style={{
+              borderRadius: "0.75rem",
+              backgroundColor: "color-mix(in srgb, var(--mantine-color-primary-6) 10%, transparent)",
+              border: "1px solid color-mix(in srgb, var(--mantine-color-primary-6) 35%, transparent)",
+            }}
+          >
+            <Text fz={13} c="text.6">
+              <b>{pending}</b> {pending === 1 ? "žádost o sledování čeká" : "žádosti o sledování čekají"}
+            </Text>
+            <Button size="compact-sm" radius="md" color="primary.6" c="black" disabled>
+              Vyřídit
+            </Button>
+          </Group>
+        ) : null}
+
+        <Text fz={13} c="var(--color-text-dim)">
+          {figures.map((figure) => `${figure.value} ${figure.label.toLowerCase()}`).join(" · ")}
+        </Text>
+      </Stack>
+    </Paper>
+  );
+}
+
+export function DashboardShareCard(): ReactElement | null {
+  const variant = usePrototypeStore((state) => state.variant);
+  if (variant === "A") return <CardA />;
+  if (variant === "B") return <CardB />;
+  return <CardC />;
+}
