@@ -0,0 +1,233 @@
+// PROTOTYPE #121 — variant A "Ovládací panel": one segmented control on top decides the
+// state; everything under it is a settings form that dims to read-only when OFF.
+import type { ReactElement } from "react";
+import { Box, Drawer, Group, Image, SegmentedControl, Stack, Switch, Text, TextInput } from "@mantine/core";
+import { useOverlayBack } from "@/hooks/useOverlayBack";
+import { inputStyles } from "@/features/add_bike_page/formStyles";
+import { bikeTitle } from "@/features/bikes/bikeTitle";
+import { handleError, profileHost } from "./handle";
+import {
+  usePrototypeStore,
+  VISIBILITY_HINT,
+  VISIBILITY_LABEL,
+  type SectionKey,
+  type Visibility,
+} from "./prototype.store";
+import { LinkActions } from "./LinkActions";
+import { DRAWER_PROPS, EYEBROW, INSET, useProfileBikes } from "./shared";
+
+const THUMB = 40;
+
+const SWITCH_STYLES = (checked: boolean) => ({
+  track: {
+    backgroundColor: checked ? "var(--mantine-color-primary-6)" : "var(--mantine-color-cards-4)",
+    borderColor: "var(--mantine-color-other-borderSolid)",
+  },
+  thumb: {
+    backgroundColor: checked ? "var(--mantine-color-black)" : "var(--mantine-color-text-6)",
+  },
+});
+
+function SectionRow({
+  label,
+  hint,
+  checked,
+  onChange,
+  nested = false,
+}: {
+  label: string;
+  hint?: string;
+  checked: boolean;
+  onChange: () => void;
+  nested?: boolean;
+}): ReactElement {
+  return (
+    <Group justify="space-between" wrap="nowrap" px="md" py={10} pl={nested ? 32 : "md"}>
+      <Stack gap={1} style={{ minWidth: 0 }}>
+        <Text fw={600} fz={15} c="text.6">
+          {label}
+        </Text>
+        {hint && (
+          <Text fz={12} c="var(--color-text-dim)">
+            {hint}
+          </Text>
+        )}
+      </Stack>
+      <Switch withThumbIndicator={false} checked={checked} onChange={onChange} styles={SWITCH_STYLES(checked)} />
+    </Group>
+  );
+}
+
+export function ShareDrawerA(): ReactElement {
+  const opened = usePrototypeStore((state) => state.drawerOpened);
+  const close = usePrototypeStore((state) => state.closeDrawer);
+  const visibility = usePrototypeStore((state) => state.visibility);
+  const setVisibility = usePrototypeStore((state) => state.setVisibility);
+  const handle = usePrototypeStore((state) => state.handle);
+  const setHandle = usePrototypeStore((state) => state.setHandle);
+  const sections = usePrototypeStore((state) => state.sections);
+  const toggleSection = usePrototypeStore((state) => state.toggleSection);
+  const toggleBike = usePrototypeStore((state) => state.toggleBike);
+  const bikes = useProfileBikes();
+  const error = handleError(handle);
+  const off = visibility === "OFF";
+
+  useOverlayBack(opened, close);
+
+  const rows: {
+    key: SectionKey;
+    label: string;
+    hint?: string;
+    nested?: boolean;
+  }[] = [
+    {
+      key: "components",
+      label: "Komponenty",
+      hint: "Osazení kola po typech dílů",
+    },
+    { key: "setup", label: "Setup", hint: "Tlaky, odpružení, profily" },
+    {
+      key: "history",
+      label: "Servisní historie",
+      hint: "Datum a úkony, bez poznámek a příloh",
+    },
+  ];
+
+  return (
+    <Drawer opened={opened} onClose={close} title="Sdílení garáže" {...DRAWER_PROPS}>
+      <Stack gap="lg">
+        <Stack gap={8}>
+          <SegmentedControl
+            fullWidth
+            value={visibility}
+            onChange={(value) => setVisibility(value as Visibility)}
+            data={(["OFF", "FOLLOWERS", "PUBLIC"] as Visibility[]).map((value) => ({
+              value,
+              label: VISIBILITY_LABEL[value],
+            }))}
+          />
+          <Text fz={13} c="var(--color-text-dim)" style={{ lineHeight: 1.45 }}>
+            {VISIBILITY_HINT[visibility]}
+          </Text>
+        </Stack>
+
+        {/* OFF keeps the form on screen but takes the hand off it: the owner sees what
+            switching back on brings, and nothing here can be changed while nobody sees it. */}
+        <Stack
+          gap="lg"
+          style={{
+            opacity: off ? 0.4 : 1,
+            pointerEvents: off ? "none" : "auto",
+            transition: "opacity 200ms",
+          }}
+        >
+          <Stack gap={8}>
+            <Text {...EYEBROW}>Adresa</Text>
+            <TextInput
+              value={handle}
+              onChange={(event) => setHandle(event.currentTarget.value.toLowerCase())}
+              leftSection={
+                <Text className="font-mono" fz={13} c="var(--color-text-dim)" pl={4}>
+                  /u/
+                </Text>
+              }
+              leftSectionWidth={36}
+              error={error}
+              styles={{
+                ...inputStyles,
+                input: {
+                  ...inputStyles.input,
+                  fontFamily: "var(--font-mono)",
+                  paddingLeft: 36,
+                },
+              }}
+              autoCapitalize="none"
+              autoCorrect="off"
+              spellCheck={false}
+            />
+            <Text className="font-mono" fz={12} c="var(--color-text-dim)" truncate>
+              {profileHost()}/u/{handle}
+            </Text>
+            <LinkActions handle={handle} enabled={visibility === "PUBLIC" && error === null} withOpen />
+            {visibility === "FOLLOWERS" && (
+              <Text fz={12} c="var(--color-text-dim)">
+                Odkaz funguje jen u veřejného profilu. Sledující tě najdou v appce podle adresy.
+              </Text>
+            )}
+          </Stack>
+
+          <Stack gap={8}>
+            <Text {...EYEBROW}>Co sdílet</Text>
+            <Box style={INSET} py={4}>
+              {rows.map((row) => (
+                <SectionRow
+                  key={row.key}
+                  label={row.label}
+                  hint={row.hint}
+                  checked={sections[row.key]}
+                  onChange={() => toggleSection(row.key)}
+                />
+              ))}
+              {sections.history && (
+                <SectionRow
+                  nested
+                  label="Ceny servisů"
+                  hint="Cena za servis, měsíční součty i útrata"
+                  checked={sections.costs}
+                  onChange={() => toggleSection("costs")}
+                />
+              )}
+            </Box>
+          </Stack>
+
+          <Stack gap={8}>
+            <Text {...EYEBROW}>Kola</Text>
+            <Box style={INSET} py={4}>
+              {bikes.map(({ bike, shared }) => (
+                <Group key={bike.id} justify="space-between" wrap="nowrap" px="md" py={8}>
+                  <Group gap="sm" wrap="nowrap" style={{ minWidth: 0 }}>
+                    {bike.image_url ? (
+                      <Image
+                        src={bike.image_url}
+                        alt=""
+                        w={THUMB}
+                        h={THUMB}
+                        radius="sm"
+                        fit="cover"
+                        style={{ flexShrink: 0, opacity: shared ? 1 : 0.4 }}
+                      />
+                    ) : (
+                      <Box
+                        w={THUMB}
+                        h={THUMB}
+                        style={{
+                          borderRadius: 6,
+                          backgroundColor: "var(--mantine-color-cards-5)",
+                          flexShrink: 0,
+                        }}
+                      />
+                    )}
+                    <Text fw={500} fz={14} c={shared ? "text.6" : "var(--color-text-dim)"} truncate>
+                      {bikeTitle(bike)}
+                    </Text>
+                  </Group>
+                  <Switch
+                    withThumbIndicator={false}
+                    checked={shared}
+                    onChange={() => toggleBike(bike.id)}
+                    styles={SWITCH_STYLES(shared)}
+                  />
+                </Group>
+              ))}
+              {bikes.length === 0 && (
+                <Text px="md" py={8} fz={13} c="var(--color-text-dim)">
+                  Zatím žádné kolo.
+                </Text>
+              )}
+            </Box>
+          </Stack>
+        </Stack>
+      </Stack>
+    </Drawer>
+  );
+}
