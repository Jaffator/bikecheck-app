+++ b/_frontend/bikecheck/src/features/profile_prototype/BikesShareEntry.tsx
@@ -0,0 +1,127 @@
+// PROTOTYPE #121 — the way into the drawer from the garage, three ways. /bikes is a main
+// tab, so its header has no actionSlot - only the bell and the avatar.
+//   A: a mono row above the cards, the archive row's twin.
+//   B: nothing in the list; an icon in the header beside the bell (BikesHeaderShareIcon).
+//   C: a banner card above the cards - a sentence about the state, dashed when OFF.
+import type { ReactElement } from "react";
+import { ActionIcon, Box, Group, Paper, Stack, Text, UnstyledButton } from "@mantine/core";
+import { useLocation } from "react-router-dom";
+import { ChevronRight, Globe, Share2, Users } from "lucide-react";
+import { usePrototypeStore, statsFor, VISIBILITY_LABEL } from "./prototype.store";
+import { PANEL, STATE_COLOR } from "./shared";
+
+function EntryA(): ReactElement {
+  const visibility = usePrototypeStore((state) => state.visibility);
+  const open = usePrototypeStore((state) => state.openDrawer);
+  const color = STATE_COLOR[visibility];
+
+  return (
+    <UnstyledButton onClick={open} px="md" py={4} className="active:scale-[0.985]">
+      <Group justify="space-between" wrap="nowrap">
+        <Text className="font-mono uppercase" fz={12} fw={500} c="var(--color-text-dim)" lts="0.08em">
+          Sdílení garáže
+        </Text>
+        <Group gap={6} wrap="nowrap">
+          {visibility !== "OFF" && <Box w={7} h={7} style={{ borderRadius: 9999, backgroundColor: color }} />}
+          <Text
+            className="font-mono uppercase"
+            fz={12}
+            fw={500}
+            lts="0.08em"
+            style={{
+              color: visibility === "OFF" ? "var(--color-text-dim)" : color,
+            }}
+          >
+            {VISIBILITY_LABEL[visibility]}
+          </Text>
+          <ChevronRight size={18} color="var(--color-text-dim)" />
+        </Group>
+      </Group>
+    </UnstyledButton>
+  );
+}
+
+function EntryC(): ReactElement {
+  const visibility = usePrototypeStore((state) => state.visibility);
+  const stats = usePrototypeStore((state) => state.stats);
+  const open = usePrototypeStore((state) => state.openDrawer);
+
+  if (visibility === "OFF") {
+    return (
+      <UnstyledButton onClick={open} className="active:scale-[0.985]" style={{ display: "block" }}>
+        <Box
+          px="md"
+          py="sm"
+          style={{
+            borderRadius: "var(--mantine-radius-lg)",
+            border: "1px dashed var(--color-border-solid)",
+          }}
+        >
+          <Group justify="space-between" wrap="nowrap">
+            <Group gap="sm" wrap="nowrap">
+              <Share2 size={18} color="var(--color-text-dim)" />
+              <Stack gap={0}>
+                <Text fw={600} fz={14} c="text.6">
+                  Sdílej svou garáž
+                </Text>
+                <Text fz={12} c="var(--color-text-dim)">
+                  Jeden odkaz na všechna kola
+                </Text>
+              </Stack>
+            </Group>
+            <ChevronRight size={18} color="var(--color-text-dim)" />
+          </Group>
+        </Box>
+      </UnstyledButton>
+    );
+  }
+
+  const color = STATE_COLOR[visibility];
+  const figures = statsFor(visibility, stats);
+
+  return (
+    <UnstyledButton onClick={open} className="active:scale-[0.985]" style={{ display: "block" }}>
+      <Paper radius="lg" px="md" py="sm" style={{ ...PANEL, boxShadow: "var(--elev-row)" }}>
+        <Group justify="space-between" wrap="nowrap">
+          <Group gap="sm" wrap="nowrap" style={{ minWidth: 0 }}>
+            {visibility === "PUBLIC" ? <Globe size={18} color={color} /> : <Users size={18} color={color} />}
+            <Stack gap={0} style={{ minWidth: 0 }}>
+              <Text fw={600} fz={14} c="text.6" truncate>
+                {visibility === "PUBLIC" ? "Garáž je veřejná" : "Garáž vidí jen sledující"}
+              </Text>
+              <Text className="font-mono" fz={11} c="var(--color-text-dim)" truncate>
+                {figures.map((figure) => `${figure.value} ${figure.label.toLowerCase()}`).join(" · ")}
+              </Text>
+            </Stack>
+          </Group>
+          <ChevronRight size={18} color="var(--color-text-dim)" />
+        </Group>
+      </Paper>
+    </UnstyledButton>
+  );
+}
+
+export function BikesShareEntry(): ReactElement | null {
+  const variant = usePrototypeStore((state) => state.variant);
+  if (variant === "A") return <EntryA />;
+  if (variant === "C") return <EntryC />;
+  return null;
+}
+
+// Variant B's entry: lives in AppLayout's header, only on /bikes.
+export function BikesHeaderShareIcon(): ReactElement | null {
+  const variant = usePrototypeStore((state) => state.variant);
+  const visibility = usePrototypeStore((state) => state.visibility);
+  const open = usePrototypeStore((state) => state.openDrawer);
+  const { pathname } = useLocation();
+  if (!import.meta.env.DEV || variant !== "B" || pathname !== "/bikes") return null;
+  const color = visibility === "OFF" ? "var(--mantine-color-cards-1)" : STATE_COLOR[visibility];
+
+  return (
+    <ActionIcon variant="transparent" radius="sm" size="lg" aria-label="Sdílení garáže" onClick={open}>
+      {visibility === "PUBLIC" && <Globe size={24} color={color} />}
+      {visibility === "FOLLOWERS" && <Users size={24} color={color} />}
+      {visibility === "OFF" && <Share2 size={24} color={color} />}
+    </ActionIcon>
+  );
+}
