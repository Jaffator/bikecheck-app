@@ -0,0 +1,213 @@
+// PROTOTYPE #121 — Settings, three ways. The section sits under the Strava card; the badge
+// sits at the avatar and name at the top of the page.
+//   A: inline segmented control + a read-only address row; badge = pill under the name.
+//   B: one row that opens the drawer, no inline control; badge = ring and bubble on the avatar.
+//   C: its own titled card with a Select; badge = chip beside the name.
+import type { ReactElement, ReactNode } from "react";
+import { Box, Card, Group, SegmentedControl, Select, Stack, Text, UnstyledButton } from "@mantine/core";
+import { ChevronRight, Globe, Users } from "lucide-react";
+import { dropdownProps, inputStyles } from "@/features/add_bike_page/formStyles";
+import { usePrototypeStore, VISIBILITY_HINT, VISIBILITY_LABEL, type Visibility } from "./prototype.store";
+import { STATE_COLOR } from "./shared";
+
+// Settings' own rhythm (ROW_GAP_HALF).
+const ROW = 10;
+const CARD_STYLE = { border: "1px solid var(--mantine-color-inputs-5)" };
+
+const STATES: Visibility[] = ["OFF", "FOLLOWERS", "PUBLIC"];
+
+function SectionA(): ReactElement {
+  const visibility = usePrototypeStore((state) => state.visibility);
+  const setVisibility = usePrototypeStore((state) => state.setVisibility);
+  const handle = usePrototypeStore((state) => state.handle);
+  const open = usePrototypeStore((state) => state.openDrawer);
+
+  return (
+    <Card bg="cards.6" className="mx-3 mb-3" px={0} py={ROW} radius="lg" style={CARD_STYLE}>
+      <Stack gap={0}>
+        <Group justify="space-between" px="md" py={ROW} wrap="nowrap">
+          <Text c="text.6" fz={15} fw={600}>
+            Veřejný profil
+          </Text>
+          <SegmentedControl
+            size="xs"
+            value={visibility}
+            onChange={(value) => setVisibility(value as Visibility)}
+            data={STATES.map((value) => ({
+              value,
+              label: VISIBILITY_LABEL[value],
+            }))}
+          />
+        </Group>
+        {/* The address is only shown here - it is changed in the drawer (#114). */}
+        <UnstyledButton onClick={open} className="w-full" px="md" py={ROW}>
+          <Group justify="space-between" wrap="nowrap">
+            <Text fw={600} fz={15} c="text.6">
+              Adresa
+            </Text>
+            <Group gap="xs" wrap="nowrap">
+              <Text className="font-mono" fz={13} c="var(--color-text-dim)" truncate>
+                /u/{handle}
+              </Text>
+              <ChevronRight size={18} color="var(--color-text-dim)" />
+            </Group>
+          </Group>
+        </UnstyledButton>
+      </Stack>
+    </Card>
+  );
+}
+
+function SectionB(): ReactElement {
+  const visibility = usePrototypeStore((state) => state.visibility);
+  const open = usePrototypeStore((state) => state.openDrawer);
+
+  return (
+    <Card bg="cards.6" className="mx-3 mb-3" px={0} py={ROW} radius="lg" style={CARD_STYLE}>
+      <UnstyledButton onClick={open} className="w-full" px="md" py={ROW}>
+        <Group justify="space-between" wrap="nowrap">
+          <Text fw={600} fz={15} c="text.6">
+            Sdílení garáže
+          </Text>
+          <Group gap="xs" wrap="nowrap">
+            <Text fz={13} style={{ color: STATE_COLOR[visibility] }}>
+              {VISIBILITY_LABEL[visibility]}
+            </Text>
+            <ChevronRight size={18} color="var(--color-text-dim)" />
+          </Group>
+        </Group>
+      </UnstyledButton>
+    </Card>
+  );
+}
+
+function SectionC(): ReactElement {
+  const visibility = usePrototypeStore((state) => state.visibility);
+  const setVisibility = usePrototypeStore((state) => state.setVisibility);
+  const handle = usePrototypeStore((state) => state.handle);
+  const open = usePrototypeStore((state) => state.openDrawer);
+
+  return (
+    <>
+      <Text className="font-mono" fz={11} fw={400} tt="uppercase" lts="0.08em" c="var(--color-text-dim)" px="md">
+        Veřejný profil
+      </Text>
+      <Card bg="cards.6" className="m-3" px="md" py="md" radius="lg" style={CARD_STYLE}>
+        <Stack gap="sm">
+          <Select
+            label="Kdo vidí moji garáž"
+            value={visibility}
+            onChange={(value) => value && setVisibility(value as Visibility)}
+            data={STATES.map((value) => ({
+              value,
+              label: VISIBILITY_LABEL[value],
+            }))}
+            allowDeselect={false}
+            comboboxProps={dropdownProps}
+            styles={inputStyles}
+          />
+          <Text fz={12} c="var(--color-text-dim)" style={{ lineHeight: 1.4 }}>
+            {VISIBILITY_HINT[visibility]}
+          </Text>
+          {visibility !== "OFF" && (
+            <UnstyledButton onClick={open} className="w-full" pt={4}>
+              <Group justify="space-between" wrap="nowrap">
+                <Text className="font-mono" fz={13} c="var(--color-text-dim)" truncate>
+                  bikecheck.app/u/{handle}
+                </Text>
+                <Group gap={4} wrap="nowrap" style={{ flexShrink: 0 }}>
+                  <Text fz={13} c="primary.5">
+                    Co sdílím
+                  </Text>
+                  <ChevronRight size={16} color="var(--mantine-color-primary-5)" />
+                </Group>
+              </Group>
+            </UnstyledButton>
+          )}
+        </Stack>
+      </Card>
+    </>
+  );
+}
+
+export function SettingsShareSection(): ReactElement {
+  const variant = usePrototypeStore((state) => state.variant);
+  if (variant === "A") return <SectionA />;
+  if (variant === "B") return <SectionB />;
+  return <SectionC />;
+}
+
+// Variant B: the state is worn by the avatar - a coloured ring and a small bubble. A/C pass through.
+export function ProfileAvatarFrame({ children }: { children: ReactNode }): ReactElement {
+  const variant = usePrototypeStore((state) => state.variant);
+  const visibility = usePrototypeStore((state) => state.visibility);
+  if (variant !== "B" || visibility === "OFF") return <>{children}</>;
+  const color = STATE_COLOR[visibility];
+  return (
+    <Box
+      style={{
+        position: "relative",
+        borderRadius: 9999,
+        padding: 3,
+        border: `2px solid ${color}`,
+      }}
+    >
+      {children}
+      <Box
+        style={{
+          position: "absolute",
+          right: -2,
+          bottom: -2,
+          width: 26,
+          height: 26,
+          borderRadius: 9999,
+          display: "flex",
+          alignItems: "center",
+          justifyContent: "center",
+          backgroundColor: color,
+          border: "3px solid var(--mantine-color-background-9)",
+        }}
+      >
+        {visibility === "PUBLIC" ? <Globe size={13} color="black" /> : <Users size={13} color="black" />}
+      </Box>
+    </Box>
+  );
+}
+
+// Variants A and C: the state is written next to the name. B says it on the avatar.
+export function ProfileNameBadge(): ReactElement | null {
+  const variant = usePrototypeStore((state) => state.variant);
+  const visibility = usePrototypeStore((state) => state.visibility);
+  if (variant === "B" || visibility === "OFF") return null;
+  const color = STATE_COLOR[visibility];
+
+  if (variant === "A") {
+    return (
+      <Group
+        gap={6}
+        wrap="nowrap"
+        px={10}
+        py={4}
+        style={{
+          borderRadius: 9999,
+          backgroundColor: `color-mix(in srgb, ${color} 14%, transparent)`,
+          border: `1px solid color-mix(in srgb, ${color} 40%, transparent)`,
+        }}
+      >
+        <Box w={7} h={7} style={{ borderRadius: 9999, backgroundColor: color }} />
+        <Text className="font-mono" fz={11} lts="0.08em" tt="uppercase" style={{ color }}>
+          {VISIBILITY_LABEL[visibility]}
+        </Text>
+      </Group>
+    );
+  }
+
+  return (
+    <Group gap={4} wrap="nowrap" style={{ color }}>
+      {visibility === "PUBLIC" ? <Globe size={13} /> : <Users size={13} />}
+      <Text fz={12} fw={600} style={{ color: "inherit" }}>
+        {VISIBILITY_LABEL[visibility]}
+      </Text>
+    </Group>
+  );
+}
