+// PROTOTYPE #121 — the dashboard card, three ways. All open the same drawer.
+//   A: a pitch when OFF (like Strava's), a one-line status strip once on. Never leaves.
+//   B: three big figures; OFF collapses to a one-line invitation. Never leaves.
+//   C: gone when OFF; once on, it is about what needs doing (pending requests) first.
+import type { ReactElement } from "react";
+import { Box, Button, Group, Paper, Stack, Text, UnstyledButton } from "@mantine/core";
+import { ChevronRight, Globe, Share2, Users } from "lucide-react";
+import { usePrototypeStore, statsFor, VISIBILITY_LABEL } from "./prototype.store";
+import { EYEBROW, PANEL, STATE_COLOR } from "./shared";
+
+function StateIcon({ size = 18 }: { size?: number }): ReactElement {
+  const visibility = usePrototypeStore((state) => state.visibility);
+  const color = STATE_COLOR[visibility];
+  if (visibility === "FOLLOWERS") return <Users size={size} color={color} />;
+  if (visibility === "PUBLIC") return <Globe size={size} color={color} />;
+  return <Share2 size={size} color={color} />;
+}
+
+function CardA(): ReactElement {
+  const visibility = usePrototypeStore((state) => state.visibility);
+  const stats = usePrototypeStore((state) => state.stats);
+  const handle = usePrototypeStore((state) => state.handle);
+  const open = usePrototypeStore((state) => state.openDrawer);
+
+  if (visibility === "OFF") {
+    return (
+      <Paper
+        radius="lg"
+        style={{
+          ...PANEL,
+          overflow: "hidden",
+          position: "relative",
+          backgroundImage:
+            "radial-gradient(120% 90% at 50% 115%, color-mix(in srgb, var(--mantine-color-primary-6) 18%, transparent) 0%, transparent 70%)",
+        }}
+      >
+        <Stack gap="lg" align="center" p="lg">
+          <Box
+            style={{
+              display: "flex",
+              alignItems: "center",
+              justifyContent: "center",
+              width: "4.5rem",
+              height: "4.5rem",
+              borderRadius: 9999,
+              backgroundColor: "color-mix(in srgb, var(--mantine-color-primary-6) 14%, transparent)",
+              border: "1px solid color-mix(in srgb, var(--mantine-color-primary-6) 35%, transparent)",
+              boxShadow: "inset 0 0 24px 0 color-mix(in srgb, var(--mantine-color-primary-6) 28%, transparent)",
+            }}
+          >
+            <Globe size={36} color="var(--mantine-color-primary-6)" />
+          </Box>
+          <Stack gap={8} align="center">
+            <Text fw={700} fz={20} c="text.6" ta="center" style={{ lineHeight: 1.25, letterSpacing: "-0.016em" }}>
+              Sdílej svou garáž
+            </Text>
+            <Text size="sm" c="var(--color-text-dim)" ta="center" style={{ lineHeight: 1.45 }}>
+              Jeden odkaz na všechna kola, osazení i servis. Ty rozhoduješ, kdo ho uvidí.
+            </Text>
+          </Stack>
+          <Button
+            fullWidth
+            radius="md"
+            color="primary.6"
+            c="black"
+            onClick={open}
+            styles={{
+              root: { height: "2.75rem" },
+              label: {
+                fontWeight: 700,
+                fontSize: "0.8125rem",
+                letterSpacing: "0.08em",
+                textTransform: "uppercase",
+              },
+            }}
+          >
+            Nastavit sdílení
+          </Button>
+        </Stack>
+      </Paper>
+    );
+  }
+
+  return (
+    <UnstyledButton onClick={open} className="active:scale-[0.985]" style={{ display: "block" }}>
+      <Paper radius="lg" px="sm" py="sm" style={PANEL}>
+        <Group gap="sm" wrap="nowrap">
+          <Box
+            style={{
+              display: "flex",
+              alignItems: "center",
+              justifyContent: "center",
+              width: "1.75rem",
+              height: "1.75rem",
+              borderRadius: "0.625rem",
+              backgroundColor: `color-mix(in srgb, ${STATE_COLOR[visibility]} 14%, transparent)`,
+            }}
+          >
+            <StateIcon size={15} />
+          </Box>
+          <Stack gap={1} style={{ flex: 1, minWidth: 0 }}>
+            <Group gap={6} wrap="nowrap">
+              <Text fw={600} fz={14} c="text.6" truncate>
+                Veřejný profil
+              </Text>
+              <Text
+                className="font-mono"
+                fz={10}
+                lts="0.08em"
+                tt="uppercase"
+                style={{ color: STATE_COLOR[visibility], flexShrink: 0 }}
+              >
+                {VISIBILITY_LABEL[visibility]}
+              </Text>
+            </Group>
+            <Text className="font-mono" fz={11} c="var(--color-text-dim)" truncate>
+              /u/{handle} ·{" "}
+              {statsFor(visibility, stats)
+                .map((stat) => `${stat.value} ${stat.label.toLowerCase()}`)
+                .join(" · ")}
+            </Text>
+          </Stack>
+          <ChevronRight size={18} color="var(--color-text-dim)" />
+        </Group>
+      </Paper>
+    </UnstyledButton>
+  );
+}
+
+function CardB(): ReactElement {
+  const visibility = usePrototypeStore((state) => state.visibility);
+  const stats = usePrototypeStore((state) => state.stats);
+  const open = usePrototypeStore((state) => state.openDrawer);
+
+  if (visibility === "OFF") {
+    return (
+      <UnstyledButton onClick={open} className="active:scale-[0.985]" style={{ display: "block" }}>
+        <Paper radius="lg" px="md" py="sm" style={{ ...PANEL, boxShadow: "var(--elev-row)" }}>
